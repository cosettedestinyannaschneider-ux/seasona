# 应用基础配置
SEASONA_APP_NAME=Seasona
SEASONA_APP_VERSION=0.1.0
SEASONA_ENVIRONMENT=local
SEASONA_API_V1_PREFIX=/api/v1
SEASONA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 数据库 / Redis / 搜索
# 本机直连示例：postgresql+psycopg://seasona_user:your_password@127.0.0.1:5432/your_db_name
SEASONA_DATABASE_URL=postgresql+psycopg://seasona_user:your_postgres_password@postgres:5432/your_db_name
SEASONA_DB_POOL_SIZE=5
SEASONA_DB_MAX_OVERFLOW=5
SEASONA_DB_POOL_TIMEOUT_SECONDS=30
SEASONA_DB_POOL_RECYCLE_SECONDS=1800
SEASONA_REDIS_URL=redis://default:your_redis_password@redis:6379/0
SEASONA_REDIS_SOCKET_TIMEOUT_SECONDS=1
SEASONA_REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=1
SEASONA_REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
SEASONA_MEILISEARCH_URL=http://meilisearch:7700
# 如果 Docker 中配置了 MEILI_MASTER_KEY，这里填写同一个值。
SEASONA_MEILISEARCH_API_KEY=
SEASONA_MEILISEARCH_INDEX=seasona_products
SEASONA_MEILISEARCH_EMBEDDER=products
SEASONA_MEILISEARCH_HOME_SEMANTIC_RATIO=0.5
SEASONA_MEILISEARCH_AI_SEMANTIC_RATIO=0.3
SEASONA_MEILISEARCH_AI_RANKING_SCORE_THRESHOLD=0.3

# 安全配置
SEASONA_JWT_SECRET_KEY=
SEASONA_JWT_ALGORITHM=HS256
SEASONA_JWT_ISSUER=seasona
SEASONA_JWT_AUDIENCE=seasona-users
SEASONA_ACCESS_TOKEN_EXPIRE_MINUTES=600
SEASONA_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
# 认证入口防刷。当前默认值偏宽松，方便课程小组短时间集中切换角色测试。
# 后期收紧时优先调整下面 6 个 SEASONA_AUTH_* 配置。
SEASONA_AUTH_RATE_LIMIT_ENABLED=true
SEASONA_AUTH_RATE_LIMIT_WINDOW_SECONDS=10
SEASONA_AUTH_LOGIN_IP_LIMIT=300
SEASONA_AUTH_LOGIN_IDENTIFIER_LIMIT=100
SEASONA_AUTH_REGISTER_IP_LIMIT=100
SEASONA_AUTH_PASSWORD_RESET_IP_LIMIT=100
SEASONA_AUTH_PASSWORD_RESET_IDENTIFIER_LIMIT=50
SEASONA_ARGON2_TIME_COST=2
SEASONA_ARGON2_MEMORY_COST=19456
SEASONA_ARGON2_PARALLELISM=1
SEASONA_ARGON2_HASH_LEN=32
SEASONA_ARGON2_SALT_LEN=16

# AI 服务
SEASONA_LLM_API_KEY=
SEASONA_LLM_BASE_URL=
SEASONA_LLM_MODEL=
SEASONA_EMBEDDING_API_KEY=
SEASONA_EMBEDDING_BASE_URL=
SEASONA_EMBEDDING_MODEL=

# 上传文件
SEASONA_MEDIA_ROOT=media
SEASONA_MEDIA_URL_PREFIX=/media
SEASONA_MAX_UPLOAD_SIZE_MB=8

# Docker 服务变量
POSTGRES_DB=seasona
POSTGRES_USER=seasona_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000
SEASONA_WEB_CONCURRENCY=2
NGINX_PORT=8080
REDIS_PORT=6379
REDIS_PASSWORD=
MEILISEARCH_PORT=7700
MEILI_MASTER_KEY=
